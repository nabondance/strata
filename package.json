{
  "name": "context-strata",
  "version": "0.8.0",
  "description": "See how your agent context evolved across Git history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabondance/strata.git"
  },
  "homepage": "https://github.com/nabondance/strata#readme",
  "bugs": {
    "url": "https://github.com/nabondance/strata/issues"
  },
  "author": "nabondance",
  "keywords": [
    "agents-md",
    "ai-agents",
    "claude-code",
    "claude-md",
    "codex",
    "context-engineering",
    "copilot",
    "cursor",
    "gemini-cli",
    "git-history",
    "github-action",
    "llm",
    "prompt-engineering",
    "skills",
    "tokens",
    "visualization"
  ],
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "strata": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/source-digest.mjs --write dist/source-digest.txt",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && node dist/cli.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "^26.6.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "d3-hierarchy": "3.1.3",
    "js-tiktoken": "1.0.21"
  }
}
