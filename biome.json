{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!pnpm-lock.yaml"] },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "includes": ["**", "!CHANGELOG.md", "!**/.claude/**/*.md", "!**/.agents/**/*.md", "!skills/**/*.md"]
  },
  "markdown": { "formatter": { "formatEmbeds": false } },
  "linter": { "enabled": true, "rules": { "style": { "noNonNullAssertion": "off" } } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
